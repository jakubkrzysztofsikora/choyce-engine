; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ziemek i Gniewko: Demo"
run/main_scene="res://src/adapters/inbound/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="choyce_engine"
config/features=PackedStringArray("4.6")

[autoload]

InputMapInitializer="*res://src/adapters/inbound/shared/input_map_initializer.gd"
ButtonFeel="*res://src/adapters/inbound/shared/ui/button_feel.gd"
AudioBank="*res://src/adapters/inbound/shared/audio/audio_bank.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

scene={
"animation/fps": 30,
"animation/import": true,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"import_script/path": "",
"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": false,
"meshes/light_baking": 0,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_type": "",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
