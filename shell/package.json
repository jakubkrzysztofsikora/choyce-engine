{
  "name": "choyce-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Choyce Engine — kid-safe Tauri 2 + Next.js shell (landing / library / parent zone / create chrome). Play stays in Godot via WS bridge on 127.0.0.1:9876.",
